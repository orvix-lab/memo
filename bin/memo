#!/usr/bin/env node
import { main } from '../cli/index.js';

main(process.argv.slice(2)).then((status) => {
  if (typeof status === 'number') {
    process.exitCode = status;
  }
}).catch((error) => {
  console.error(error instanceof Error ? error.message : String(error));
  process.exitCode = 1;
});
